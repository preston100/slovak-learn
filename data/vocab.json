  {
    "topic": "Useful Phrases",
    "words": [
      {
        "sk": "Nemáte / Nemáš za čo. // Rado sa stalo.",
        "en": "You're welcome."
      },
      {
        "sk": "Teší ma. // Rád Vás / ťa spoznávam.",
        "en": "Nice to meet you."
      },
      {
        "sk": "Nerozumiem.",
        "en": "I don't understand."
      },
      {
        "sk": "Prosím, pomalšie.",
        "en": "Please, more slowly."
      },
      {
        "sk": "Môžeš / Môžete hovoriť pomalšie?",
        "en": "Can you speak more slowly?"
      },
      {
        "sk": "Ešte raz, prosím.",
        "en": "Once again, please."
      },
      {
        "sk": "Môžeš / Môžete to zopakovať, prosím?",
        "en": "Can you repeat it, please?"
      },
      {
        "sk": "Dobrú chuť!",
        "en": "Enjoy your meal!"
      },
      {
        "sk": "Na zdravie!",
        "en": "Cheers! / Bless you! (also for sneezes)"
      },
      {
        "sk": "Ja si neprosím. (Ja nechcem)",
        "en": "I don't want to."
      },
      {
        "sk": "Som plný. // Už mi stačí.",
        "en": "I am full. / I have enough."
      },
      {
        "sk": "Koľko to stojí? / Koľko to je?",
        "en": "How much is it?"
      },
      {
        "sk": "Platím kartou. / Kartou, prosím.",
        "en": "I am paying by card."
      },
      {
        "sk": "Platím v hotovosti.",
        "en": "I am paying in cash."
      },
      {
        "sk": "Prosím si účet.",
        "en": "The bill, please."
      },
      {
        "sk": "Zaplatím.",
        "en": "I would like to pay."
      },
      {
        "sk": "Môžem poprosiť menu / jedálny lístok.",
        "en": "Could I have a menu?"
      },
      {
        "sk": "Môžem poprosiť nápojový lístok.",
        "en": "Could I have a drinks menu?"
      },
      {
        "sk": "To je všetko, ďakujem.",
        "en": "That's all, thank you."
      },
      {
        "sk": "To je v pohode. / Drobné si nechajte.",
        "en": "Keep the change."
      },
      {
        "sk": "Tašku si neprosím.",
        "en": "I don't want a bag."
      },
      {
        "sk": "Vystupujem.",
        "en": "I am getting off."
      },
      {
        "sk": "Je tu obsadené? / Je toto miesto obsadené?",
        "en": "Is this seat taken?"
      },
      {
        "sk": "Je tu voľné? / Je toto miesto voľné?",
        "en": "Is this seat free?"
      },
      {
        "sk": "Mám lístok.",
        "en": "I have a ticket."
      },
      {
        "sk": "Voní to pekne.",
        "en": "It smells nice."
      },
      {
        "sk": "Veľmi pekne ďakujem.",
        "en": "Thank you very much."
      },
      {
        "sk": "Potrebujem pomoc.",
        "en": "I need help."
      },
      {
        "sk": "Prajem pekný deň.",
        "en": "Have a nice day."
      },
      {
        "sk": "Šťastnú cestu!",
        "en": "Have a safe trip!"
      }
    ]
  },
