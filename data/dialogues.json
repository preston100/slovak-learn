        "who": "Turistka",
        "sk": "Je to ďaleko?",
        "en": "Is it far?"
      },
      {
        "who": "Pán",
        "sk": "Nie, je to blízko. Asi päť minút pešo.",
        "en": "No, it's near. About five minutes on foot."
      },
      {
        "who": "Turistka",
        "sk": "A môžem ísť aj autobusom?",
        "en": "And can I go by bus too?"
      },
      {
        "who": "Pán",
        "sk": "Áno, autobus číslo tri ide na stanicu. Zastávka je tam, vpravo.",
        "en": "Yes, bus number three goes to the station. The stop is there, on the right."
      },
      {
        "who": "Turistka",
        "sk": "Ďakujem veľmi pekne.",
        "en": "Thank you very much."
      },
      {
        "who": "Pán",
        "sk": "Nemáte za čo. Dovidenia.",
        "en": "You're welcome. Goodbye."
